{
  "name": "unstorage",
  "version": "2.0.0-alpha.9",
  "description": "Universal Storage Layer",
  "homepage": "https://unstorage.unjs.io",
  "license": "MIT",
  "repository": "unjs/unstorage",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./tracing": {
      "types": "./dist/tracing.d.mts",
      "default": "./dist/tracing.mjs"
    },
    "./drivers/*": "./dist/drivers/*.mjs",
    "./server": "./dist/server.mjs"
  },
  "scripts": {
    "bench": "node test/server.bench.ts",
    "build": "pnpm gen-drivers && obuild",
    "dev": "vitest",
    "gen-drivers": "node scripts/gen-drivers.ts",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "oxlint . --fix && oxfmt .",
    "prepack": "pnpm build",
    "release": "pnpm test && pnpm build && changelogen --prerelease --release && npm publish --tag alpha",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@azure/app-configuration": "^1.12.1",
    "@azure/cosmos": "^4.10.0",
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.33.0",
    "@capacitor/preferences": "^8.0.1",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@deno/kv": "^0.14.0",
    "@electric-sql/pglite": "^0.5.5",
    "@libsql/client": "^0.17.4",
    "@netlify/blobs": "^11",
    "@planetscale/database": "^1.20.1",
    "@types/deno": "^2.7.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.3",
    "@vitest/coverage-v8": "^4.1.11",
    "aws4fetch": "^1.0.20",
    "azurite": "^3.36.0",
    "changelogen": "^0.6.2",
    "chokidar": "^5.0.0",
    "citty": "^0.2.2",
    "db0": "^0.3.4",
    "destr": "^2.0.5",
    "eslint-config-unjs": "^0.6.2",
    "fake-indexeddb": "^6.2.5",
    "get-port-please": "^3.2.0",
    "idb-keyval": "^6.3.0",
    "ioredis": "^6.0.0",
    "ioredis-mock": "^8.13.1",
    "jsdom": "^30.0.1",
    "lru-cache": "^11.5.2",
    "mitata": "^1.0.34",
    "mlly": "^1.8.2",
    "mongodb": "^7.5.0",
    "mongodb-memory-server": "^11.2.0",
    "obuild": "^0.4.38",
    "ofetch": "^1.5.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "scule": "^1.3.0",
    "srvx": "^0.12.5",
    "typescript": "^7.0.2",
    "uploadthing": "^7.7.4",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.22.0"
}
